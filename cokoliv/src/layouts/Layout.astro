---
import Tracking from '../components/Tracking.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  conversion?: boolean;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  canonical,
  conversion = false
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="cs">
<head>
  <Tracking conversion={conversion} />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site).toString()} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="cs_CZ" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Montserrat+Alternates:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org RealEstateAgent / Person -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "RealEstateAgent",
    "name": "Mgr. Iveta Smolková",
    "image": "https://ivetasmolkova.cz/og-default.jpg",
    "telephone": "+420777879317",
    "email": "iveta.smolkova@email.cz",
    "url": "https://ivetasmolkova.cz",
    "areaServed": ["Brno", "Olomouc", "Zlín"],
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "CZ",
      "addressLocality": "Brno"
    },
    "jobTitle": "Realitní makléřka",
    "knowsAbout": ["Prodej bytů", "Pronájem bytů", "Realitní poradenství"]
  })} />
</head>
<body class="bg-white text-slate-900 antialiased font-sans">
  <slot />
</body>
</html>

<style is:global>
  html { scroll-behavior: smooth; }
  body { font-family: 'Montserrat', system-ui, sans-serif; }
  h1, h2, h3, .display { font-family: 'Montserrat Alternates', 'Montserrat', sans-serif; }
</style>
