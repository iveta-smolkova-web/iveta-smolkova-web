---
import Tracking from '../components/Tracking.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  conversion?: boolean;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  canonical,
  conversion = false
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="cs">
<head>
  <Tracking conversion={conversion} />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site).toString()} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="cs_CZ" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Montserrat+Alternates:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org Person + RealEstateAgent / LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://ivetasmolkova.cz/#iveta",
        "name": "Mgr. Iveta Smolková",
        "jobTitle": "Realitní makléřka",
        "image": "https://ivetasmolkova.cz/images/iveta-portrait.jpg",
        "url": "https://ivetasmolkova.cz/o-mne",
        "telephone": "+420777879317",
        "email": "Iveta.Smolkova@email.cz",
        "worksFor": { "@id": "https://ivetasmolkova.cz/#agent" },
        "knowsAbout": [
          "Prodej bytů a domů",
          "Pronájem nemovitostí",
          "Prodej zděděných nemovitostí",
          "Nemovitosti ve spoluvlastnictví",
          "Tržní odhad ceny nemovitosti",
          "Advokátní úschova a převod v katastru"
        ],
        "areaServed": ["Olomouc", "Olomoucký kraj", "Brno", "Zlín"],
        "sameAs": [
          "https://www.sreality.cz/adresar/iveta-smolkova-reality-proradost-olomouc-nove-sady/38508"
        ]
      },
      {
        "@type": ["RealEstateAgent", "LocalBusiness"],
        "@id": "https://ivetasmolkova.cz/#agent",
        "name": "Mgr. Iveta Smolková — realitní makléřka (REALITY PRORADOST)",
        "image": "https://ivetasmolkova.cz/images/iveta-logo-full.png",
        "url": "https://ivetasmolkova.cz",
        "telephone": "+420777879317",
        "email": "Iveta.Smolkova@email.cz",
        "priceRange": "Provize dle dohody",
        "currenciesAccepted": "CZK",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Trnkova 539/36",
          "addressLocality": "Olomouc",
          "addressRegion": "Olomoucký kraj",
          "postalCode": "779 00",
          "addressCountry": "CZ"
        },
        "areaServed": [
          { "@type": "City", "name": "Olomouc" },
          { "@type": "AdministrativeArea", "name": "Olomoucký kraj" },
          { "@type": "City", "name": "Brno" },
          { "@type": "City", "name": "Zlín" }
        ],
        "parentOrganization": {
          "@type": "Organization",
          "name": "REALITY PRORADOST s.r.o."
        },
        "employee": { "@id": "https://ivetasmolkova.cz/#iveta" },
        "knowsAbout": [
          "Prodej bytů",
          "Pronájem bytů",
          "Prodej zděděných nemovitostí",
          "Realitní poradenství"
        ],
        "sameAs": [
          "https://www.sreality.cz/adresar/iveta-smolkova-reality-proradost-olomouc-nove-sady/38508"
        ]
      }
    ]
  })} />
</head>
<body class="bg-white text-slate-900 antialiased font-sans">
  <slot />
  <!-- Iveta AI chatbot widget (Ivetka) -->
  <script is:raw data-cfasync="false">
    window.IvetaChatbotConfig = {
      backendUrl: 'https://chatbot.ivetasmolkova.cz',
      primaryColor: '#C9A961',
      creamColor: '#F5EDE0',
      inkColor: '#2a2520',
      agentName: 'Iveta',
      welcomeMessage: '👋 Dobrý den! Jsem **Iveta AI** — asistentka Ivety Smolkové. Pomůžu vám najít byt, ocenit nemovitost, nebo se domluvit přímo s Ivetou. S čím začneme?'
    };
  </script>
  <script is:inline data-cfasync="false" src="https://chatbot.ivetasmolkova.cz/widget-loader.js?v=20260528-fullconfig"></script>
</body>
</html>

<style is:global>
  html { scroll-behavior: smooth; }
  body { font-family: 'Montserrat', system-ui, sans-serif; }
  h1, h2, h3, .display { font-family: 'Montserrat Alternates', 'Montserrat', sans-serif; }
</style>
